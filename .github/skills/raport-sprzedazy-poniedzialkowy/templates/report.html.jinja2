<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raport sprzedaży — {{ period }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body { background: white; }
            .no-print { display: none; }
            .page-break { page-break-after: always; }
            table { page-break-inside: avoid; }
            h2 { page-break-after: avoid; }
        }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #d1d5db; padding: 12px; text-align: left; }
        th { background: #1f2937; color: white; font-weight: bold; }
        tr:nth-child(even) { background: #f9fafb; }
        tr:last-child { font-weight: bold; background: #e5e7eb; }
        .positive { color: #059669; }
        .negative { color: #dc2626; }
        .warning { color: #d97706; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans">
    <div class="max-w-4xl mx-auto px-6 py-8">
        <!-- Header -->
        <div class="mb-8 border-b-2 border-gray-300 pb-4">
            <h1 class="text-4xl font-bold text-gray-900">Raport sprzedaży</h1>
            <p class="text-xl text-gray-600 mt-2">{{ period }}</p>
            <p class="text-sm text-gray-500 mt-2">
                {% if status == 'ready' %}
                <span class="text-green-600 font-semibold">✅ Status: Gotowy</span>
                {% else %}
                <span class="text-orange-600 font-semibold">⚠️ Status: Niekompletny</span>
                {% endif %}
            </p>
        </div>

        <!-- Sekcja 1: Sprzedaż netto -->
        <section class="mb-10 page-break">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Podsumowanie — Sprzedaż netto (PLN)</h2>
            
            <table class="mb-6">
                <thead>
                    <tr>
                        <th>Kanał</th>
                        <th style="text-align: right;">W38 (bieżący)</th>
                        <th style="text-align: right;">W37 (poprzedni)</th>
                        <th style="text-align: right;">Zmiana WoW</th>
                        <th style="text-align: right;">YoY (14–20.09.2025)</th>
                        <th style="text-align: right;">Zmiana YoY</th>
                    </tr>
                </thead>
                <tbody>
                    {% for channel in ['ONLINE', 'STORE', 'RAZEM'] %}
                    {% set m = metrics[channel] %}
                    {% set c = changes[channel] %}
                    <tr>
                        <td class="font-semibold">{{ channel }}</td>
                        <td style="text-align: right;">{{ "{:,.0f}".format(m.NetAmount) }}</td>
                        <td style="text-align: right;">{{ "{:,.0f}".format(m.PrevWeekNet) }}</td>
                        <td style="text-align: right;" class="{% if c.WoW_pct > 0 %}positive{% else %}negative{% endif %}">
                            {{ "{:+.1f}%".format(c.WoW_pct) }}
                        </td>
                        <td style="text-align: right;">{{ "{:,.0f}".format(m.YoYNet) }}</td>
                        <td style="text-align: right;" class="{% if c.YoY_pct > 0 %}positive{% elif c.YoY_pct < -15 %}negative{% else %}warning{% endif %}">
                            {{ "{:+.1f}%".format(c.YoY_pct) }}
                            {% if c.IsSignificant %}<span class="font-bold">⚠️</span>{% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <!-- Sekcja 2: Sztuki i transakcje -->
        <section class="mb-10 page-break">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Sztuki i transakcje</h2>
            
            <table>
                <thead>
                    <tr>
                        <th>Kanał</th>
                        <th style="text-align: right;">Sztuki W38</th>
                        <th style="text-align: right;">Sztuki W37</th>
                        <th style="text-align: right;">Zmiana</th>
                        <th style="text-align: right;">Transakcje W38</th>
                        <th style="text-align: right;">Transakcje W37</th>
                        <th style="text-align: right;">Zmiana</th>
                    </tr>
                </thead>
                <tbody>
                    {% for channel in ['ONLINE', 'STORE', 'RAZEM'] %}
                    {% set m = metrics[channel] %}
                    <tr>
                        <td class="font-semibold">{{ channel }}</td>
                        <td style="text-align: right;">{{ m.Quantity }}</td>
                        <td style="text-align: right;">-</td>
                        <td style="text-align: right;">-</td>
                        <td style="text-align: right;">{{ m.Transactions }}</td>
                        <td style="text-align: right;">-</td>
                        <td style="text-align: right;">-</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <!-- Sekcja 3: Interpretacja -->
        <section class="mb-10 page-break">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Wstępna interpretacja</h2>
            
            {% if interpretation %}
            <ul class="space-y-2 text-gray-700">
                {% for point in interpretation %}
                <li class="flex items-start">
                    <span class="mr-3">•</span>
                    <span>{{ point }}</span>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="text-gray-600 italic">Brak istotnych zmian</p>
            {% endif %}
        </section>

        <!-- Sekcja 4: Źródło danych -->
        <section class="mb-10">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Źródło danych</h2>
            
            <ul class="space-y-1 text-gray-700">
                {% for item in data_source %}
                <li class="flex items-start">
                    <span class="mr-3">•</span>
                    <span>{{ item }}</span>
                </li>
                {% endfor %}
            </ul>
        </section>

        <!-- Footer -->
        <div class="mt-12 pt-6 border-t border-gray-300 text-sm text-gray-500">
            <p>Wygenerowano: {{ generated_at }}</p>
            <p class="mt-2">Raport sprzedaży Nordvik — RetailDW</p>
        </div>
    </div>

    <!-- Print button -->
    <div class="no-print fixed bottom-4 right-4 space-x-2">
        <button onclick="window.print()" class="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700">
            🖨️ Drukuj / Zapisz PDF
        </button>
    </div>
</body>
</html>
